run = "PYTHONPATH=/home/runner/workspace/.pythonlibs/lib/python3.11/site-packages python app.py"
modules = ["python-3.11"]

[nix]
channel = "stable-24_05"

[deployment]
run = ["bash", "-c", "python3 -m gunicorn app:app --bind 0.0.0.0:8080 --workers 1 --timeout 120"]
deploymentTarget = "autoscale"

[[ports]]
localPort = 5000
externalPort = 80

[env]
FLASK_APP = "app.py"
PYTHONPATH = "/home/runner/workspace/.pythonlibs/lib/python3.11/site-packages"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 -m flask run --host=0.0.0.0 --port=5000"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"
