# Supabase project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=https://your-project.supabase.co

# Supabase SERVICE ROLE key (NOT the anon key).
#
# WHY the service role key: our tables have Row Level Security enabled with no
# policies, which denies everyone. The service_role key bypasses RLS, so the
# server keeps full access while the outside world gets nothing.
#
# THIS IS A SECRET. It is a full database admin credential. Never commit it,
# never put it in a template, never send it to a browser. Find it in the
# Supabase dashboard under Project Settings > API Keys > service_role.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

SPORTSDB_API_KEY=your-key-or-1-for-free-tier

# Shared secret used to authenticate the /api/push-scores cron endpoint.
FLASK_SECRET_KEY=change-this-to-something-random
